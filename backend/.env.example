# Copy to .env and fill in.

PORT=4000

# MongoDB connection string (Atlas or local), include the database name
MONGODB_URI=mongodb://127.0.0.1:27017/deed_hostels

# Random string, at least 32 characters. Generate with:  openssl rand -base64 48
AUTH_SECRET=

# Origin(s) of the web app, comma-separated. Used for CORS and the CSRF origin check.
FRONTEND_URL=http://localhost:3000

# Set to 1 when the API sits behind the Next.js proxy or any reverse proxy (so the real client IP is used for rate limiting)
TRUST_PROXY=1

# Day of the month rent is due (used for "days overdue")
DUE_DAY=5

# Where tenant photo uploads are stored on disk (see README before deploying to serverless hosts)
UPLOAD_DIR=./uploads

# --- Phase 2: M-Pesa Daraja STK Push (not implemented yet, see src/services/mpesa.ts) ---
